<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cinetix.LoginController" styleClass="root-dark">
    <VBox styleClass="login-left" prefWidth="550" HBox.hgrow="ALWAYS">
        <Label text="CineTix" styleClass="brand-big"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Label text="Staff portal" styleClass="h1"/>
        <Label text="Sell tickets, manage showtimes and accounts. Your role decides which screen opens." styleClass="muted" wrapText="true"/>
    </VBox>
    <VBox alignment="CENTER" prefWidth="550" HBox.hgrow="ALWAYS">
        <VBox maxWidth="320" spacing="8">
            <Label text="LOGIN" styleClass="h1" maxWidth="Infinity" alignment="CENTER"/>
            <Label text="For cinema staff only." styleClass="muted" maxWidth="Infinity" alignment="CENTER"/>
            <Label text="Username"/><TextField fx:id="user" promptText="Type your username."/>
            <Label text="Password"/>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <StackPane HBox.hgrow="ALWAYS">
                    <PasswordField fx:id="pass" promptText="Type your password." onAction="#login" maxWidth="Infinity"/>
                    <TextField fx:id="passText" promptText="Type your password." onAction="#login" maxWidth="Infinity" visible="false" managed="false"/>
                </StackPane>
                <Button fx:id="eye" text="Show" styleClass="sm" onAction="#togglePw" minWidth="56"/>
            </HBox>
            <Label fx:id="error" styleClass="error" wrapText="true"/>
            <Button text="Log in" styleClass="btn" maxWidth="Infinity" onAction="#login" defaultButton="true"/>
            <Button text="Forgot password?" styleClass="link" maxWidth="Infinity" onAction="#forgot"/>
        </VBox>
    </VBox>
</HBox>
